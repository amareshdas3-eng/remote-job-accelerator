# ==============================================================================
# Remote Job Automator (RJA) v4.3 - Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL of the deployed application (e.g. https://app.example.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional comma-separated CORS allowed origins for API routes
ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# ------------------------------------------------------------------------------
# 2. SUPABASE PRODUCTION INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Public Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous API Key (used by SSR client with Row Level Security enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# CRITICAL SECURITY WARNING:
# Service Role Key bypasses all Row Level Security.
# NEVER expose to client-side bundles or prefix with NEXT_PUBLIC_.
# Used exclusively by backend API routes for elevated administrative sync operations.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 3. AI INFERENCE & RELIABILITY CONFIGURATION
# ------------------------------------------------------------------------------
# Primary OpenAI-compatible inference endpoint
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=sk-...

# Primary model name (fallback cascaded in lib/ai.ts)
AI_MODEL=gpt-4o-mini

# Optional timeout in ms (default 15000ms in lib/ai.ts)
AI_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & STRUCTURED LOGGING
# ------------------------------------------------------------------------------
# Log level: 'debug' | 'info' | 'warn' | 'error' (defaults to 'info')
LOG_LEVEL=info

# PostHog Analytics & Telemetry
POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION, OAUTH & RECOVERY
# ------------------------------------------------------------------------------
# Google OAuth Provider (configured in Google Cloud Console with authorized redirect URIs)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_PROVIDER_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Extension Authentication JWT Secret (min 32 characters)
EXTENSION_JWT_SECRET=replace-with-a-cryptographically-secure-random-32-byte-hex

# ------------------------------------------------------------------------------
# 6. MONETIZATION, SUBSCRIPTIONS & WEBHOOKS
# ------------------------------------------------------------------------------
# Gumroad Webhook ping verification secret
GUMROAD_PING_SECRET=
GUMROAD_PRODUCT_PERMALINK=remote-job-complete
NEXT_PUBLIC_GUMROAD_URL=https://4217411968942.gumroad.com/l/remote-job-complete

# ------------------------------------------------------------------------------
# 7. PRODUCTION SMTP EMAIL (CONFIGURED IN SUPABASE DASHBOARD)
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Project Settings -> Authentication -> SMTP Settings:
# - Sender Email: no-reply@yourdomain.com
# - Sender Name: Remote Job Automator
# - Host: smtp.resend.com or smtp.sendgrid.net
# - Port: 465 (SSL) or 587 (TLS)
# - User / Password: Provided by your ESP

